# ---------------------------------------------------------------------------
# TransAID Environment Configuration Template
# Copy this file to .env and configure the variables for your local setup.
# ---------------------------------------------------------------------------

# YOLO Model Configuration
YOLO_MODEL_PATH=models/weights/best.pt
DATA_YAML=dataset/data.yaml

# ChromaDB Vector Store Configuration
CHROMA_PATH=src/cdss/chroma_db
JOURNALS_FOLDER=src/cdss/knowledge_base
COLLECTION_NAME=karies_knowledge

# LLM / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:12b
LLM_API_KEY=ollama
JUDGE_MODEL=qwen3:14b

# Output Directories
CDSS_OUTPUT_DIR=outputs/reports
GEVAL_INPUT_DIR=outputs/reports
GEVAL_OUTPUT_DIR=outputs/geval
RAGAS_INPUT_DIR=outputs/reports
RAGAS_OUTPUT_DIR=outputs/ragas

# Jetson Inference Deployment
JETSON_MODEL_ONNX=models/yolov8s_best.onnx
JETSON_MODEL_TRT=models/yolov8s_best.engine
JETSON_TEST_IMAGE_DIR=images/
JETSON_OUTPUT_DIR=benchmark_results/
